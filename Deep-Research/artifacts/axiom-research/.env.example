# EmailJS credentials — copy to .env and fill in from https://dashboard.emailjs.com
# Service ID & Public Key: Account > General
# Template IDs: Email Services > your service > your template
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_CONTACT=
VITE_EMAILJS_TEMPLATE_LEAD=

# Backend API base URL. This is the deployed API server (Express) that the app
# talks to — the research pipeline behind it runs on the FastAPI backend.
# Leave unset for local dev (Vite proxies /api to localhost:5000).
# In production, set this to the deployed API server URL, e.g.
#   VITE_API_URL=https://axiom-api-server.onrender.com
VITE_API_URL=http://localhost:5000
